{
  "name": "agent-review",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/diff": "^8.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.64.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@pierre/diffs": "^1.6.2",
    "@xyflow/react": "^12.12.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "elkjs": "^0.12.0",
    "marked": "^18.1.2",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "version": "0.1.0",
  "description": "Review AI agent work on a canvas: current flow, proposal, actual change and iterations as variants of one map.",
  "bin": {
    "agent-review": "src/cli.ts"
  },
  "scripts": {
    "dev": "bun --hot src/cli.ts serve examples",
    "serve": "bun src/cli.ts serve",
    "validate": "bun src/cli.ts validate",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "schema": "bun src/cli.ts schema view > schema/view.schema.json && bun src/cli.ts schema review > schema/review.schema.json"
  },
  "license": "MIT"
}